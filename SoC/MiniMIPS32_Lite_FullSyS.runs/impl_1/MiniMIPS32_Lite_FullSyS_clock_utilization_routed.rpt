# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y16 [get_cells sys_clk_25M_IBUF_BUFG_inst]
set_property LOC BUFGCTRL_X0Y0 [get_cells r_dce0_BUFG_inst]
set_property LOC BUFGCTRL_X0Y1 [get_cells dout__0_BUFG_inst]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y74 [get_ports sys_clk_25M]

# Clock net "sys_clk_25M_IBUF_BUFG" driven by instance "sys_clk_25M_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_sys_clk_25M_IBUF_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_sys_clk_25M_IBUF_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="sys_clk_25M_IBUF_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_sys_clk_25M_IBUF_BUFG}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "r_dce0_BUFG" driven by instance "r_dce0_BUFG_inst" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_r_dce0_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_r_dce0_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="r_dce0_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_r_dce0_BUFG}] -add {CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "dout__0_BUFG" driven by instance "dout__0_BUFG_inst" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_dout__0_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_dout__0_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="dout__0_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_dout__0_BUFG}] -add {CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup
